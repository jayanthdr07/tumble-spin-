rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating common types
    function isStringOfSize(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isNumberInRange(val, min, max) {
      return val is number && val >= min && val <= max;
    }

    // --- ORDERS COLLECTION rules ---
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // --- REVIEWS COLLECTION rules ---
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // --- SETTINGS COLLECTION rules ---
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // --- MEMBERSHIPS COLLECTION rules ---
    match /memberships/{phone} {
      allow read, write: if true;
    }

    // --- MEMBERSHIPS PENDING COLLECTION rules ---
    match /memberships_pending/{id} {
      allow read, write: if true;
    }

    // --- PAYMENT ATTEMPTS COLLECTION rules ---
    match /payment_attempts/{id} {
      allow read, write: if true;
    }

    // --- PAYMENTS COLLECTION rules ---
    match /payments/{id} {
      allow read, write: if true;
    }

    // --- COUNTERS COLLECTION rules ---
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // --- WEBHOOK EVENTS COLLECTION rules ---
    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    // --- TEST COLLECTION rules ---
    match /test/{testId} {
      allow read, write: if true;
    }

    // --- CATALOG ITEMS COLLECTION rules ---
    match /catalog_items/{itemId} {
      allow read, write: if true;
    }
  }
}

